# RDK-X5 已验证运行基线，2026-10-07。
# 由 scripts/perf/run.sh 加载；调用者显式设置的环境变量优先。
# 图像尺寸、15 Hz 和 DFL 参数属于模型/程序接口，不在本配置中修改。
WARMUP=${WARMUP:-5}
QUEUE_CAPACITY=${QUEUE_CAPACITY:-1}
CAPTURE_CPUS=${CAPTURE_CPUS:-2-3}
INFERENCE_CPUS=${INFERENCE_CPUS:-0-7}
RT_PRIORITY=${RT_PRIORITY:-0}
CPU_GOVERNOR=${CPU_GOVERNOR:-performance}
SAVE_RESULTS=${SAVE_RESULTS:-async}
LOG_LEVEL=${LOG_LEVEL:-info}
INFERENCE_START_DELAY=${INFERENCE_START_DELAY:-1}
